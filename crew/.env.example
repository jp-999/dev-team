# Copy to crew/.env and fill in. CrewAI routes through LiteLLM, so you can use any provider.

# Pick the model the whole team uses (LiteLLM model string).
#   OpenAI:    gpt-4o-mini  |  gpt-4o
#   Anthropic: anthropic/claude-sonnet-4-5
DEVTEAM_MODEL=gpt-4o-mini

# Provide the key for whichever provider your DEVTEAM_MODEL uses.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
